#!/usr/bin/python3
import fcntl
import hashlib
import os
from pathlib import Path
import shutil
import subprocess
import time


def connected_monitors():
    monitors = []
    for connector in sorted(Path('/sys/class/drm').glob('card*-*')):
        if '-DP-' not in connector.name and '-HDMI-A-' not in connector.name:
            continue
        try:
            if (connector / 'status').read_text().strip() != 'connected':
                continue
            edid = (connector / 'edid').read_bytes()
            if not edid:
                continue
        except OSError:
            continue
        monitors.append((connector.name, hashlib.sha256(edid).hexdigest()))
    return tuple(monitors)


def main():
    runtime = os.environ.get('XDG_RUNTIME_DIR')
    if os.environ.get('XDG_SESSION_TYPE') != 'wayland' or not runtime:
        return
    if not shutil.which('gdctl'):
        return
    if subprocess.run(['/usr/bin/vita-dock-displays', '--check-enabled'],
                      check=False).returncode:
        return
    with (Path(runtime) / 'vita-dock-displays-watch.lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        observed = applied = None
        changed = retry_after = 0
        env = os.environ.copy()
        env['VITA_DOCK_REQUIRE_DOCK'] = '0'
        while True:
            monitors = connected_monitors()
            now = time.monotonic()
            if monitors != observed:
                observed, changed = monitors, now
            if len(monitors) < 2:
                applied = None
            elif monitors != applied and now - changed >= 2 and now >= retry_after:
                try:
                    result = subprocess.run(['/usr/bin/vita-dock-displays'],
                                            env=env, timeout=180, check=False)
                    if result.returncode == 0:
                        applied = monitors
                        print('Display layout applied.', flush=True)
                    else:
                        retry_after = time.monotonic() + 30
                except (OSError, subprocess.TimeoutExpired) as error:
                    print(f'Display layout failed: {error}', flush=True)
                    retry_after = time.monotonic() + 30
            time.sleep(2)


if __name__ == '__main__':
    main()
