# USB-C MST dock display layout (Wayland / gdctl).
#
# MODE:
#   auto          — 2 DP + panel (dual), or 3 DP (triple), or HDMI+2 DP (combo)
#   dual          — built-in panel + two external DP monitors
#   triple        — three external DP only (built-in display off in layout)
#   hdmi-combo    — SoC HDMI + two external DP (built-in display off)
#   external-only — alias for triple
#
# REQUIRE_DOCK: skip if no Type-C partner (hot-unplugged dock)
REQUIRE_DOCK=1

MODE=auto

# Dual MST: highest-EDID monitor modeset first (claims VP0 for 1440p).
# Second monitor on VP2: 1680x1050 modesets but often rainbows when paired
# with 1440p (2-lane MST bandwidth/FIFO). Prefer 1280x1024@60 (matched CRTC).
DUAL_HI_MODE=2560x1440@59.951
DUAL_LO_MODE=1280x1024@60.020

# Triple / combo external modes
TRIPLE_EXT_MODE=1920x1080@60.000
