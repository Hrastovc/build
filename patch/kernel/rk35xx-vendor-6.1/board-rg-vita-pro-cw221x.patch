From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: crackerjacques <jack@supremeoverlordjabs.co>
Date: Wed, 29 Jul 2026 19:19:21 +0200
Subject: power: supply: cw221x: fix status and workqueue handling

Report full charge correctly and reject failed workqueue allocation.

Signed-off-by: crackerjacques <jack@supremeoverlordjabs.co>
---
 drivers/power/supply/cw221x_battery.c | 18 +++++-----
 1 file changed, 9 insertions(+), 9 deletions(-)

diff --git a/drivers/power/supply/cw221x_battery.c b/drivers/power/supply/cw221x_battery.c
index 111111111111..222222222222 100644
--- a/drivers/power/supply/cw221x_battery.c
+++ b/drivers/power/supply/cw221x_battery.c
@@ -425,7 +425,7 @@ static int cw_get_current(struct cw_battery *cw_bat)
 	else if ((cw_bat->fw_version != 0) && ((cw_bat->fw_version & 0xC0) == CW2218_MARK))
 		cw_current = cw_current * 3815 / cw_bat->user_rsense;
 	else {
-		cw_bat->cw_current = 0;
+		cw_current = 0;
 		dev_err(cw_bat->dev, "error! cw221x firmware read error!\n");
 	}
 
@@ -782,18 +782,16 @@ static int cw_battery_get_property(struct power_supply *psy,
 			val->intval = POWER_SUPPLY_CAPACITY_LEVEL_FULL;
 		break;
 	case POWER_SUPPLY_PROP_STATUS:
-		if (cw_bat->ui_soc == 100 * 1000)
+		if (cw_bat->ui_soc == 100)
 			val->intval = POWER_SUPPLY_STATUS_FULL;
-		else {
-			if (power_supply_is_system_supplied())
-				val->intval = POWER_SUPPLY_STATUS_CHARGING;
-			else
-				val->intval = POWER_SUPPLY_STATUS_DISCHARGING;
-		}
+		else if (power_supply_is_system_supplied())
+			val->intval = POWER_SUPPLY_STATUS_CHARGING;
+		else
+			val->intval = POWER_SUPPLY_STATUS_DISCHARGING;
 		break;
 	case POWER_SUPPLY_PROP_CHARGE_FULL:
 	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
-		val->intval = 10 * 1000 * 1000;/* uAh */
+		val->intval = 10 * 1000 * 1000; /* uAh */
 		break;
 	case POWER_SUPPLY_PROP_HEALTH:
 		val->intval = POWER_SUPPLY_HEALTH_GOOD;
@@ -889,6 +887,8 @@ static int cw221X_probe(struct i2c_client *client, const struct i2c_device_id *i
 	}
 
 	cw_bat->cwfg_workqueue = create_singlethread_workqueue("cwfg_gauge");
+	if (!cw_bat->cwfg_workqueue)
+		return -ENOMEM;
 	INIT_DELAYED_WORK(&cw_bat->battery_delay_work, cw_bat_work);
 	queue_delayed_work(cw_bat->cwfg_workqueue,
 			   &cw_bat->battery_delay_work,
-- 
Armbian

