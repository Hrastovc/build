From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hrastovc <hrastovc@gmail.com>
Date: Wed, 18 Nov 2026 18:00:00 +0100
Subject: phy: rockchip: preserve clocks during four-lane DP configuration

---
 drivers/phy/rockchip/phy-rockchip-usbdp.c | 136 ++++++++--
 1 file changed, 106 insertions(+), 30 deletions(-)

diff --git a/drivers/phy/rockchip/phy-rockchip-usbdp.c b/drivers/phy/rockchip/phy-rockchip-usbdp.c
index 111111111111..222222222222 100644
--- a/drivers/phy/rockchip/phy-rockchip-usbdp.c
+++ b/drivers/phy/rockchip/phy-rockchip-usbdp.c
@@ -639,6 +639,21 @@ static int udphy_dp_hpd_event_trigger(struct rockchip_udphy *udphy, bool hpd)
 	return 0;
 }
 
+static void udphy_set_sbu_dc(struct rockchip_udphy *udphy)
+{
+	/* Set AUX DC bias for the connector orientation. */
+	if (udphy->flip) {
+		gpiod_set_value_cansleep(udphy->sbu1_dc_gpio, 1);
+		gpiod_set_value_cansleep(udphy->sbu2_dc_gpio, 0);
+	} else {
+		gpiod_set_value_cansleep(udphy->sbu1_dc_gpio, 0);
+		gpiod_set_value_cansleep(udphy->sbu2_dc_gpio, 1);
+	}
+	dev_dbg(udphy->dev, "AUX SBU: flip=%u levels=%d,%d\n",
+		udphy->flip, gpiod_get_value_cansleep(udphy->sbu1_dc_gpio),
+		gpiod_get_value_cansleep(udphy->sbu2_dc_gpio));
+}
+
 static int udphy_set_typec_default_mapping(struct rockchip_udphy *udphy)
 {
 	if (udphy->flip) {
@@ -652,8 +667,6 @@ static int udphy_set_typec_default_mapping(struct rockchip_udphy *udphy)
 		udphy->lane_mux_sel[3] = PHY_LANE_MUX_USB;
 		udphy->dp_aux_dout_sel = PHY_AUX_DP_DATA_POL_INVERT;
 		udphy->dp_aux_din_sel = PHY_AUX_DP_DATA_POL_INVERT;
-		gpiod_set_value_cansleep(udphy->sbu1_dc_gpio, 1);
-		gpiod_set_value_cansleep(udphy->sbu2_dc_gpio, 0);
 	} else {
 		udphy->dp_lane_sel[0] = 2;
 		udphy->dp_lane_sel[1] = 3;
@@ -665,10 +678,9 @@ static int udphy_set_typec_default_mapping(struct rockchip_udphy *udphy)
 		udphy->lane_mux_sel[3] = PHY_LANE_MUX_DP;
 		udphy->dp_aux_dout_sel = PHY_AUX_DP_DATA_POL_NORMAL;
 		udphy->dp_aux_din_sel = PHY_AUX_DP_DATA_POL_NORMAL;
-		gpiod_set_value_cansleep(udphy->sbu1_dc_gpio, 0);
-		gpiod_set_value_cansleep(udphy->sbu2_dc_gpio, 1);
 	}
 
+	udphy_set_sbu_dc(udphy);
 	udphy->mode = UDPHY_MODE_DP_USB;
 	udphy->dp_lanes = 2;
 
@@ -682,6 +694,7 @@ static int udphy_orien_sw_set(struct typec_switch_dev *sw,
 
 	mutex_lock(&udphy->mutex);
 
+	dev_dbg(udphy->dev, "Type-C orientation=%u\n", orien);
 	if (orien == TYPEC_ORIENTATION_NONE) {
 		gpiod_set_value_cansleep(udphy->sbu1_dc_gpio, 0);
 		gpiod_set_value_cansleep(udphy->sbu2_dc_gpio, 0);
@@ -760,14 +773,17 @@ static int udphy_status_check(struct rockchip_udphy *udphy)
 	unsigned int val;
 	int ret;
 
-	/* LCPLL check */
+	/* LCPLL check (USB3). Billboard-only docks never lock; continue for DP. */
 	if (udphy->mode & UDPHY_MODE_USB) {
 		ret = regmap_read_poll_timeout(udphy->pma_regmap, CMN_ANA_LCPLL_DONE_OFFSET,
 					       val, (val & CMN_ANA_LCPLL_AFC_DONE) &&
 					       (val & CMN_ANA_LCPLL_LOCK_DONE), 200, 100000);
 		if (ret) {
-			dev_err(udphy->dev, "cmn ana lcpll lock timeout\n");
-			return ret;
+			dev_warn(udphy->dev,
+				 "cmn ana lcpll lock timeout, disable u3 and continue\n");
+			udphy_u3_port_disable(udphy, true);
+			if (udphy->dp_lanes >= 4)
+				udphy->mode &= ~UDPHY_MODE_USB;
 		}
 	}
 
@@ -800,7 +816,14 @@ static int udphy_status_check(struct rockchip_udphy *udphy)
 static int udphy_init(struct rockchip_udphy *udphy)
 {
 	const struct rockchip_udphy_cfg *cfg = udphy->cfgs;
-	int ret;
+	int i, ret;
+
+	for (i = 0; i < cfg->num_rsts; i++) {
+		ret = reset_control_assert(udphy->rsts[i]);
+		if (ret)
+			return ret;
+	}
+	usleep_range(10000, 11000);
 
 	/* enable rx lfps for usb */
 	if (udphy->mode & UDPHY_MODE_USB)
@@ -914,6 +937,26 @@ static int udphy_disable(struct rockchip_udphy *udphy)
 	return 0;
 }
 
+static int udphy_reinit(struct rockchip_udphy *udphy)
+{
+	int ret;
+
+	if (udphy->mode == UDPHY_MODE_DP) {
+		/* Keep DWC3 registers accessible during lane reconfiguration. */
+		udphy_u3_port_disable(udphy, true);
+		udelay(10);
+		ret = udphy_init(udphy);
+		if (ret)
+			udphy_disable(udphy);
+		return ret;
+	}
+
+	ret = udphy_disable(udphy);
+	if (ret)
+		return ret;
+	return udphy_setup(udphy);
+}
+
 static int rk_udphy_get_tune_sequence(struct rockchip_udphy *udphy)
 {
 	struct device *dev = udphy->dev;
@@ -1147,19 +1190,7 @@ static int udphy_power_on(struct rockchip_udphy *udphy, u8 mode)
 		udphy->mode_change = false;
 		udphy->status = UDPHY_MODE_NONE;
 
-		/*
-		 * For DP 4xlanes + USB2 only scenario, it needs to
-		 * select utmi clock from the USB2 PHY for the USB
-		 * controller source clock, then it can safely disable
-		 * the USBDP PHY later to reconfigure lanes for DP.
-		 */
-		if (udphy->mode == UDPHY_MODE_DP)
-			udphy_u3_port_disable(udphy, true);
-
-		ret = udphy_disable(udphy);
-		if (ret)
-			return ret;
-		ret = udphy_setup(udphy);
+		ret = udphy_reinit(udphy);
 		if (ret)
 			return ret;
 	}
@@ -1201,6 +1232,9 @@ static int rockchip_dp_phy_power_on(struct phy *phy)
 
 	phy_set_bus_width(phy, udphy->dp_lanes);
 
+	/* Re-drive SBU before AUX traffic (orientation may have raced). */
+	udphy_set_sbu_dc(udphy);
+
 	ret = udphy_power_on(udphy, UDPHY_MODE_DP);
 	if (ret)
 		goto unlock;
@@ -1209,14 +1243,17 @@ static int rockchip_dp_phy_power_on(struct phy *phy)
 	if (ret)
 		goto unlock;
 
+	/* Replay HPD that arrived before PHY was ready. */
+	if (udphy->dp_sink_hpd_sel)
+		udphy_dp_hpd_event_trigger(udphy, udphy->dp_sink_hpd_cfg);
+
 unlock:
 	mutex_unlock(&udphy->mutex);
 	/*
-	 * If data send by aux channel too fast after phy power on,
-	 * the aux may be not ready which will cause aux error. Adding
-	 * delay to avoid this issue.
+	 * VIA MST hubs need longer AUX settle after combophy bring-up;
+	 * 10ms was enough for SST/HP docks but ESI fails on this hub.
 	 */
-	usleep_range(10000, 11000);
+	usleep_range(50000, 60000);
 	return ret;
 }
 
@@ -1487,8 +1524,26 @@ static int usbdp_typec_mux_set(struct typec_mux_dev *mux,
 		mode = UDPHY_MODE_DP;
 		udphy->dp_lanes = 4;
 		break;
-	case TYPEC_DP_STATE_D:
+	case TYPEC_STATE_SAFE:
 		fallthrough;
+	case TYPEC_STATE_USB:
+		/* Configure prelude — do not remap to DP_USB. */
+		goto hpd_only;
+	case TYPEC_DP_STATE_D:
+		if (udphy->flip) {
+			udphy->lane_mux_sel[0] = PHY_LANE_MUX_DP;
+			udphy->lane_mux_sel[1] = PHY_LANE_MUX_DP;
+			udphy->lane_mux_sel[2] = PHY_LANE_MUX_USB;
+			udphy->lane_mux_sel[3] = PHY_LANE_MUX_USB;
+		} else {
+			udphy->lane_mux_sel[0] = PHY_LANE_MUX_USB;
+			udphy->lane_mux_sel[1] = PHY_LANE_MUX_USB;
+			udphy->lane_mux_sel[2] = PHY_LANE_MUX_DP;
+			udphy->lane_mux_sel[3] = PHY_LANE_MUX_DP;
+		}
+		mode = UDPHY_MODE_DP_USB;
+		udphy->dp_lanes = 2;
+		break;
 	default:
 		if (udphy->flip) {
 			udphy->lane_mux_sel[0] = PHY_LANE_MUX_DP;
@@ -1506,6 +1561,31 @@ static int usbdp_typec_mux_set(struct typec_mux_dev *mux,
 		break;
 	}
 
+	/* Keep AUX path alive across pin remaps. */
+	udphy_set_sbu_dc(udphy);
+
+	if (udphy->mode != mode) {
+		udphy->mode = mode;
+		udphy->mode_change = true;
+	}
+
+	if (udphy->mode_change && udphy->status != UDPHY_MODE_NONE) {
+		int ret;
+
+		udphy->mode_change = false;
+		udphy->status = UDPHY_MODE_NONE;
+		ret = udphy_reinit(udphy);
+		if (ret)
+			dev_err(udphy->dev, "failed to re-init combophy for new mode\n");
+		else {
+			udphy->status = udphy->mode;
+			if (udphy->mode & UDPHY_MODE_DP)
+				udphy_dplane_enable(udphy, udphy->dp_lanes);
+			udphy_set_sbu_dc(udphy);
+		}
+	}
+
+hpd_only:
 	if (state->alt && state->alt->svid == USB_TYPEC_DP_SID) {
 		struct typec_displayport_data *data = state->data;
 
@@ -1520,10 +1600,6 @@ static int usbdp_typec_mux_set(struct typec_mux_dev *mux,
 			usleep_range(750, 800);
 			udphy_dp_hpd_event_trigger(udphy, true);
 		} else if (data->status & DP_STATUS_HPD_STATE) {
-			if (udphy->mode != mode) {
-				udphy->mode = mode;
-				udphy->mode_change = true;
-			}
 			udphy_dp_hpd_event_trigger(udphy, true);
 		} else {
 			udphy_dp_hpd_event_trigger(udphy, false);
-- 
Armbian

