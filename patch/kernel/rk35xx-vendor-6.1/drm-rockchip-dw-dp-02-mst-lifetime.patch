+static void dw_dp_mst_teardown(struct dw_dp *dp, const char *why)
+{
+	dev_dbg(dp->dev, "MST teardown (%s)\n", why);
+	dp->mst_disconnecting = true;
+	dp->mst_esi_muted = true; /* stop poll during teardown */
+	/*
+	 * Wait for appear to finish. Async cancel_work raced with appear and
+	 * can race teardown. Appearance no longer sends a nested hotplug event.
+	 */
+	cancel_work_sync(&dp->mst_appear_work);
+	atomic_set(&dp->mst_appear_busy, 0);
+	dp->is_mst = false;
+	drm_dp_mst_topology_mgr_set_mst(&dp->mst_mgr, false);
+
+	memset(&dp->link.train, 0, sizeof(dp->link.train));
+	dp->mst_esi_fail_streak = 0;
+	dw_dp_mst_power_put(dp);
+	dp->mst_esi_muted = false;
+	dp->mst_disconnecting = false;
+}
+
+static void dw_dp_mst_appear_work(struct work_struct *work)
+{
+	struct dw_dp *dp = container_of(work, struct dw_dp, mst_appear_work);
+	int ret;
+
+	if (dp->mst_disconnecting) {
+		atomic_set(&dp->mst_appear_busy, 0);
+		return;
+	}
+
+	if (dp->is_mst) {
+		dev_dbg(dp->dev, "MST appear skipped (already up)\n");
+		atomic_set(&dp->mst_appear_busy, 0);
+		return;
+	}
+
+	dev_dbg(dp->dev, "MST appear work: settle/train/set_mst\n");
+	dp->mst_esi_muted = false;
+	dp->mst_esi_fail_streak = 0;
+	ret = dw_dp_mst_power_get(dp);
+	if (ret)
+		goto out_fail;
+	msleep(300);
+	if (dp->mst_disconnecting)
+		goto out_fail;
+
+	dw_dp_link_power_up(dp);
+	ret = dw_dp_link_train(dp);
+	if (ret < 0 || !dw_dp_link_train_valid(&dp->link.train)) {
+		dev_err(dp->dev, "MST appear train failed: %d\n", ret);
+		goto out_fail;
+	}
+	dw_dp_mst_enable(dp);
+	msleep(100);
+	if (dp->mst_disconnecting)
+		goto out_fail;
+
+	/* Probe AUX before LINK_ADDRESS; one unstick if the post-train bus is dead. */
+	{
+		u8 rev;
+
+		ret = drm_dp_dpcd_readb(&dp->aux, DP_DPCD_REV, &rev);
+		if (ret < 0) {
+			dev_warn(dp->dev, "MST appear: pre-set_mst AUX dead (%d), unstick\n",
+				 ret);
+			dw_dp_aux_unstick(dp, "appear pre-set_mst");
+			msleep(50);
+			ret = drm_dp_dpcd_readb(&dp->aux, DP_DPCD_REV, &rev);
+		}
+		if (ret < 0) {
+			dev_err(dp->dev, "MST appear: AUX still dead after unstick (%d)\n",
+				ret);
+			goto out_fail;
+		}
+		dev_dbg(dp->dev, "MST appear: pre-set_mst AUX ok (dpcd=0x%02x)\n", rev);
+	}
+	msleep(200);
+	if (dp->mst_disconnecting)
+		goto out_fail;
+
+	ret = drm_dp_mst_topology_mgr_set_mst(&dp->mst_mgr, true);
+	if (ret < 0) {
+		dev_err(dp->dev, "failed to enable MST: %d\n", ret);
+		goto out_fail;
+	}
+	if (dp->mst_disconnecting)
+		goto out_fail;
+	/* The core discovers ports asynchronously and owns request timeouts. */
+	dp->is_mst = true;
+	atomic_set(&dp->mst_appear_busy, 0);
+	return;
+
+out_fail:
+	/* Train/LINK_ADDRESS fail must not stick is_mst across unplug/replug. */
+	drm_dp_mst_topology_mgr_set_mst(&dp->mst_mgr, false);
+	dp->is_mst = false;
+	memset(&dp->link.train, 0, sizeof(dp->link.train));
+	dw_dp_mst_power_put(dp);
+	atomic_set(&dp->mst_appear_busy, 0);
+}
