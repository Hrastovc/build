+static void dw_dp_mst_topology_poll_hpd_irq(struct drm_dp_mst_topology_mgr *mgr)
+{
+	struct dw_dp *dp = container_of(mgr, struct dw_dp, mst_mgr);
+	u8 esi[4] = {};
+	u8 ack[4] = {};
+	bool handled = false;
+	int ret;
+
+	/*
+	 * Do not gate on mst_appear_busy: appear work holds that flag across
+	 * set_mst()/LINK_ADDRESS, and poll_hpd_irq must run every ~50ms to
+	 * catch DOWN_REP (sink clears it after ~110ms).
+	 */
+	if (dp->mst_disconnecting || dp->mst_esi_muted)
+		return;
+
+	mutex_lock(&dp->mst_irq_lock);
+	ret = drm_dp_dpcd_read(&dp->aux, DP_SINK_COUNT_ESI, esi, 4);
+	if (ret != 4) {
+		dp->mst_esi_fail_streak++;
+		dev_dbg_ratelimited(dp->dev,
+			"MST POLL: ESI read failed ret=%d streak=%u\n",
+			ret, dp->mst_esi_fail_streak);
+		goto out;
+	}
+
+	dp->mst_esi_fail_streak = 0;
+
+	if (esi[1] & DP_DOWN_REP_MSG_RDY)
+		dev_dbg_ratelimited(dp->dev,
+				     "MST POLL: DOWN_REP ready in ESI\n");
+
+	drm_dp_mst_hpd_irq_handle_event(&dp->mst_mgr, esi, ack, &handled);
+	if (!memchr_inv(ack, 0, sizeof(ack)))
+		goto out;
+
+	if (drm_dp_dpcd_write(&dp->aux, DP_SINK_COUNT_ESI + 1, &ack[1], 3) < 0) {
+		dp->mst_esi_fail_streak++;
+		goto out;
+	}
+	if (ack[1] & (DP_DOWN_REP_MSG_RDY | DP_UP_REQ_MSG_RDY))
+		drm_dp_mst_hpd_irq_send_new_request(&dp->mst_mgr);
+out:
+	mutex_unlock(&dp->mst_irq_lock);
+}
