+/*
+ * USB-C AUX often sticks after prolonged main-link TX (link train).
+ * Deliberate reset after train / before sideband; do not reset mid wait_tx_reply.
+ */
+static void dw_dp_aux_unstick(struct dw_dp *dp, const char *why)
+{
+	dev_dbg(dp->dev, "MST AUX unstick after %s\n", why);
+	regmap_update_bits(dp->regmap, DPTX_SOFT_RESET_CTRL,
+			   AUX_RESET, AUX_RESET);
+	usleep_range(20, 40);
+	regmap_update_bits(dp->regmap, DPTX_SOFT_RESET_CTRL,
+			   AUX_RESET, 0);
+	usleep_range(50, 100);
+	dw_dp_aux_init(dp);
+}
