From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hrastovc <hrastovc@gmail.com>
Date: Wed, 18 Nov 2026 18:00:00 +0100
Subject: drm/rockchip: detect legacy MST sinks before probing DPCD

---
 drivers/gpu/drm/rockchip/dw-dp.c | 18 +++++++---
 1 file changed, 13 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/rockchip/dw-dp.c b/drivers/gpu/drm/rockchip/dw-dp.c
index 111111111111..222222222222 100644
--- a/drivers/gpu/drm/rockchip/dw-dp.c
+++ b/drivers/gpu/drm/rockchip/dw-dp.c
@@ -4021,12 +4021,20 @@ static int dw_dp_mst_connector_detect(struct drm_connector *connector,
 	if (drm_connector_is_unregistered(connector))
 		return connector_status_disconnected;
 
-	ret = drm_dp_dpcd_readb(&mst_conn->port->aux, DP_DPRX_FEATURE_ENUMERATION_LIST, &dpcd);
-	if (ret < 0)
-		return connector_status_disconnected;
+	ret = drm_dp_mst_detect_port(connector, ctx, &dp->mst_mgr, mst_conn->port);
+	if (ret != connector_status_connected)
+		return ret;
 
-	mst_conn->vsc_sdp_extension_for_colorimetry_supported =
-		!!(dpcd & DP_VSC_SDP_EXT_FOR_COLORIMETRY_SUPPORTED);
+	ret = drm_dp_dpcd_readb(&mst_conn->port->aux, DP_DPRX_FEATURE_ENUMERATION_LIST, &dpcd);
+	if (ret >= 0) {
+		mst_conn->vsc_sdp_extension_for_colorimetry_supported =
+			!!(dpcd & DP_VSC_SDP_EXT_FOR_COLORIMETRY_SUPPORTED);
+	} else {
+		/* Legacy HDMI converters often lack remote DPCD. */
+		dev_dbg(dp->dev,
+			"MST detect: remote DPCD fail %d, use port status\n",
+			ret);
+	}
 
 	return drm_dp_mst_detect_port(connector, ctx, &dp->mst_mgr,
 				      mst_conn->port);
-- 
